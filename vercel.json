{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {"source": "/", "destination": "/api/site?page=home"},
    {"source": "/index", "destination": "/api/site?page=home"},
    {"source": "/projects", "destination": "/api/site?page=gallery"}
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' https://*.blob.vercel-storage.com; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
